@* A row is drawn for every period but written only once it says something: RoomLevels creates a row on the
   first value set and drops it when the last is cleared, or four drawn rows would pin four values nobody
   chose and the schedule would stop reaching this room. Nothing here writes to disk. *@

<div class="levels">
	@if (Periods.Count == 0)
	{
		<div class="empty">No periods yet</div>
	}

	@* Said once at the top of the table and not again on every row. Below the width the columns need, the rows
	   stack and each control carries its own label instead, or a slider would sit under nothing. *@
	@if (Periods.Count > 0)
	{
		<div class="lvl lvl-head" aria-hidden="true">
			<span class="lvl-head-cell">Period</span>
			<span class="lvl-head-cell">Temperature</span>
		</div>
	}

	@foreach (RoomLevelRow row in RoomLevels.Rows(Periods, Room))
	{
		RoomLevelRow current = row;
		bool isNow = string.Equals(current.PeriodId, ActivePeriod, StringComparison.OrdinalIgnoreCase);

		<div class="lvl @(current.IsOwn ? "lvl-own" : null) @(isNow ? "lvl-now" : null)" @key="current.PeriodId">
			<div class="lvl-when">
				<span class="lvl-name">@PeriodName(current.Name)</span>
				@if (isNow)
				{
					<span class="badge active-now" title="This period is in force right now.">now</span>
				}
				<span class="lvl-start">@StartOf(current.PeriodId)</span>
			</div>

			<div class="lvl-cell">
				<PresetSlider Value="@(current.Temperature ?? Presets.TemperatureCelsius[0].Value)"
							  AtDefault="@(current.Source == LevelSource.Schedule && current.Temperature is not null)"
							  Inheritable="true"
							  DefaultLabel="the house's"
							  Options="@Presets.TemperatureCelsius"
							  Unit="°C"
							  Label="Temperature"
							  Mixed="@(current.Temperature is null ? "not set" : null)"
							  AriaLabel="@($"Temperature during {PeriodName(current.Name)}")"
							  ValueChanged="@(value => SetTemperature(current.PeriodId, value))">
					<Mark>
						@if (current.Temperature is { } celsius)
						{
							<span class="lvl-swatch" style="@Swatch(celsius)" aria-hidden="true"></span>
						}
						@if (current.Source == LevelSource.Room)
						{
							<span class="tok-own-dot" title="This room's own setting" aria-hidden="true"></span>
						}
					</Mark>
				</PresetSlider>
			</div>
		</div>
	}

	@* Rows this room wrote for a period the schedule no longer has: periods carry stable ids, so a rename
	   cannot strand one. *@
	@{
		IReadOnlyList<RoomLevelOrphan> orphans = RoomLevels.Orphans(Periods, Room);

		// Hoisted: read inside the loop it would be recomputed twice per orphan, on a page that ticks at 1 Hz.
		IReadOnlyList<TimePeriodConfig> free = orphans.Count > 0 ? RoomLevels.FreePeriods(Periods, Room) : [];
	}

	@foreach (RoomLevelOrphan orphan in orphans)
	{
		RoomLevelOrphan current = orphan;

		<div class="lvl lvl-orphan" @key="@($"orphan:{current.PeriodId}")">
			<div class="lvl-when">
				<span class="lvl-name">@current.Name</span>
				<span class="lvl-start">no period is called this any more</span>
			</div>

			<div class="lvl-cell lvl-orphan-says">
				<span class="lvl-cell-label">This room still pins</span>
				<span class="lvl-orphan-value">@current.Says</span>
			</div>

			<div class="lvl-cell">
				<span class="lvl-cell-label">Move it to a period, or remove it</span>
				@if (free.Count > 0)
				{
					<select class="cell" value="" @onchange="@(args => Repoint(current.PeriodId, args.Value as string))">
						<option value="">move it to&hellip;</option>
						@foreach (TimePeriodConfig period in free)
						{
							<option value="@period.Key">@period.Name</option>
						}
					</select>
				}
				<button type="button" class="lvl-drop" @onclick="() => Drop(current.PeriodId)">Remove it</button>
			</div>
		</div>
	}
</div>

@code {
	/// <summary>The document's period list, read here and never edited.</summary>
	[Parameter, EditorRequired]
	public List<TimePeriodConfig> Periods { get; set; } = [];

	/// <summary>The room being edited, in place.</summary>
	[Parameter, EditorRequired]
	public AreaConfig Room { get; set; } = new();

	/// <summary>The id of the period in force right now, or <c>null</c> when none is.</summary>
	[Parameter]
	public string? ActivePeriod { get; set; }

	/// <summary>Raised after any change, so the page can re-validate and start its save timer.</summary>
	[Parameter]
	public EventCallback Changed { get; set; }

	/// <summary>The same placeholder the schedule editor uses for an unnamed period.</summary>
	private static string PeriodName(string name) => name is { Length: > 0 } ? name : "unnamed period";

	/// <summary>When the period starts, bracketed beside its name; the row already says which period it is.</summary>
	private string StartOf(string periodId)
	{
		if (Found(periodId) is not { } found)
			return string.Empty;

		return PeriodStartText.Short(found.Start) is { Length: > 0 } boundary ? $"[{boundary}]" : "start not set";
	}

	private TimePeriodConfig? Found(string periodId) => Periods.ByKey(periodId);

	// TemperatureColour.Css writes its own invariant integers, so no decimal comma reaches the colour function.
	private static string Swatch(double celsius) => $"--lvl-temp: {TemperatureColour.Css(celsius)}";

	// null is the slider's leftmost stop: the room states nothing and the schedule reaches it again.
	private Task SetTemperature(string periodId, double? value)
	{
		RoomLevels.SetTemperature(Room, periodId, value);

		return Changed.InvokeAsync();
	}

	private Task Drop(string periodId)
	{
		RoomLevels.Remove(Room, periodId);

		return Changed.InvokeAsync();
	}

	private Task Repoint(string fromPeriodId, string? toPeriodId)
	{
		if (toPeriodId is not { Length: > 0 } target || !RoomLevels.Repoint(Room, fromPeriodId, target))
			return Task.CompletedTask;

		return Changed.InvokeAsync();
	}
}
