@inherits LayoutComponentBase
@implements IDisposable
@using AdaptiveHeating.Page.Components
@inject IStringLocalizer<AdaptiveHeating.Page.Resources.PageStrings> Words
@inject NavigationManager Navigation

@* No rooted link anywhere: every href is relative, so it resolves against the base the page declared for this
	request. A rooted one leaves the page for Home Assistant's own root whatever the base says. *@
<div class="app">
	<header class="top">
		<div class="brand">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3c0 3-2 3-2 5.5S10 11 10 14" /><path d="M15 6c0 2.5-1.6 2.5-1.6 4.5S15 13 15 15" /><path d="M5 20h14" stroke-width="1.2" opacity=".5" /></svg>
			<span>@Words["Brand"]</span>
		</div>
		<nav class="nav" aria-label="@Words["NavLabel"]">
			<a href="" class="@TabClass(Tab.Dashboard)" aria-current="@Current(Tab.Dashboard)">@Words["NavDashboard"]</a>
			<a href="activity" class="@TabClass(Tab.Activity)" aria-current="@Current(Tab.Activity)">@Words["NavActivity"]</a>
			<a href="settings" class="@TabClass(Tab.Settings)" aria-current="@Current(Tab.Settings)">@Words["NavSettings"]</a>
		</nav>
		<div class="top-end">
			<ThemeSelect />
			<a class="feedback-link" href="@FeedbackHref" target="_blank" rel="noopener"
			   aria-label="@Words["GiveFeedback"]" title="@Words["GiveFeedback"]">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path d="M20 14.4 A2.1 2.1 0 0 1 17.9 16.5 H10.2 L6.2 19.8 V16.5 H6.1 A2.1 2.1 0 0 1 4 14.4 V6.9 A2.1 2.1 0 0 1 6.1 4.8 H17.9 A2.1 2.1 0 0 1 20 6.9 Z" />
				</svg>
				<span class="feedback-link-text">@Words["GiveFeedback"]</span>
			</a>
		</div>
	</header>

	<main class="main">
		@Body
	</main>

	<nav class="tabbar" aria-label="@Words["NavLabel"]">
		<a href="" class="@TabClass(Tab.Dashboard)" aria-current="@Current(Tab.Dashboard)">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h10M4 12h16M4 17h7" /></svg>
			<span>@Words["NavDashboard"]</span>
		</a>
		<a href="activity" class="@TabClass(Tab.Activity)" aria-current="@Current(Tab.Activity)">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12" /><circle cx="4" cy="6" r="1" /><circle cx="4" cy="12" r="1" /><circle cx="4" cy="18" r="1" /></svg>
			<span>@Words["NavActivity"]</span>
		</a>
		<a href="settings" class="@TabClass(Tab.Settings)" aria-current="@Current(Tab.Settings)">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" /></svg>
			<span>@Words["NavSettings"]</span>
		</a>
	</nav>
</div>

@code {
	// Built once: the version cannot change while the process runs, and this renders on every page.
	private static readonly string FeedbackHref = FeedbackUrl.Build(HalfVersions.AddOnVersion);

	private enum Tab { Dashboard, Activity, Settings }

	private Tab _current;

	/// <inheritdoc/>
	protected override void OnInitialized()
	{
		_current = TabOf(Navigation.Uri);
		Navigation.LocationChanged += OnLocationChanged;
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
	{
		Tab next = TabOf(args.Location);

		if (next == _current)
			return;

		_current = next;
		_ = InvokeAsync(StateHasChanged);
	}

	// A room page belongs to the Dashboard tab: rooms open from there.
	private Tab TabOf(string uri)
	{
		string path = Navigation.ToBaseRelativePath(uri);

		if (path.StartsWith("settings", StringComparison.OrdinalIgnoreCase))
			return Tab.Settings;

		if (path.StartsWith("activity", StringComparison.OrdinalIgnoreCase))
			return Tab.Activity;

		return Tab.Dashboard;
	}

	private string? TabClass(Tab tab) => tab == _current ? "cur" : null;

	private string? Current(Tab tab) => tab == _current ? "page" : null;

	/// <inheritdoc/>
	public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
